{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portazos",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "CONTADOR",
				"class_name": "ContadorVisitas"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ContadorVisitas"]
		}
	]
}
